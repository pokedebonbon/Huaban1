/* =====================================================================
   3. 狀態 / localStorage
   【功能】記住學生的進度：XP、連續天數、完成哪些步驟、答錯哪些題、單字熟悉度。
   【原理】資料存在瀏覽器的 localStorage（存在學生自己的手機/電腦，不會上傳）。
   【變數 S】整個 APP 的「進度本」。S.xp 是經驗值，S.stages 是已完成的步驟…
   【什麼時候改】新增功能要多記一種資料時，才需要動 defaults（預設值）。
   【下面的小工具】$、shuffle、plain 是全站共用的小幫手，不用改。
   ===================================================================== */
// // 把時間轉成「年-月-日」文字，用來判斷「今天」「昨天」（算連續天數、每日目標）
function dstr(ts){ return new Date(ts||Date.now()).toLocaleDateString('en-CA'); }
// // 進度本 S 的「預設值」（全新使用者的樣子）。
// // 想多記一種資料（例如新功能），就在這裡加一個欄位。
// //   lang 介面語言   xp 總經驗值   dailyXp 今天的經驗值   streak 連續天數
// //   done 舊版已完成的課   stages ★新版已完成的步驟（'1:vl' 代表單元1的單字學習）
// //   vocab 每個生詞的熟悉度   wrong 答錯的題目   grammar 需要重練的文法
// //   speech 口說紀錄   history 最近學習紀錄   quiz 累計答題數
const defaults = () => ({lang:'zh',xp:0,dailyXp:0,dailyDate:dstr(),streak:0,lastDay:null,done:{},stages:{},vocab:{},wrong:{},grammar:{},speech:{},history:[],quiz:{c:0,t:0},lastLesson:null});
// // 開啟網頁時：從瀏覽器 localStorage 讀回上次的進度；讀不到就用預設值
function load(){ try{ const r=JSON.parse(localStorage.getItem(STORE_KEY)); return Object.assign(defaults(), r||{}); }catch(e){ return defaults(); } }
let S = load();
// // 把目前進度 S 存進瀏覽器。每次進度有變動（答題、完成步驟）都會呼叫它
function save(){ try{ localStorage.setItem(STORE_KEY, JSON.stringify(S)); }catch(e){} }

// // 小幫手：$('#id') 等於 document.querySelector('#id')，用來找到畫面上的元素
const $ = s => document.querySelector(s);
// // 小幫手：把清單隨機打亂（配對題、排序題用）
const shuffle = a => { a=a.slice(); for(let i=a.length-1;i>0;i--){ const j=Math.random()*(i+1)|0; [a[i],a[j]]=[a[j],a[i]]; } return a; };
// // 小幫手：用 id 找到生詞（vById('v1') 會回傳「你好」那筆資料）／用 id 找到單元
const vById = id => VOCAB.find(v=>v.id===id);
const unitById = id => UNITS.find(u=>u.id===id);
// // 小幫手：把拼音的聲調、空格去掉並轉小寫，所以學生輸入 xuesheng 也能對上 xuéshēng
const plain = s => String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\s/g,'').toLowerCase();

// // 跨日時，把「今天的 XP」歸零
function rollDaily(){ if(S.dailyDate!==dstr()){ S.dailyDate=dstr(); S.dailyXp=0; } }
// // 更新「連續學習天數」：昨天有學 → +1；中斷了 → 從 1 重新算
function touchStreak(){ const td=dstr(); if(S.lastDay===td) return; const y=dstr(Date.now()-864e5); S.streak=(S.lastDay===y)?S.streak+1:1; S.lastDay=td; }
// // 增加經驗值 XP（同時更新每日目標與連續天數，並存檔）
function addXp(n){ rollDaily(); S.xp+=n; S.dailyXp+=n; touchStreak(); save(); }
function streakNow(){ const td=dstr(), y=dstr(Date.now()-864e5); return (S.lastDay===td||S.lastDay===y)?S.streak:0; }

// // ── 單元／步驟 的「完成」與「解鎖」判斷 ──
// // lessonDone  ：舊版某堂課是否完成（單元二到五用）
const lessonDone = lid => !!S.done[lid];
// // unitDone：單元是否全部完成。plan 單元看「5 個步驟是否都完成」，舊單元看「所有課是否完成」
const unitDone = u => u.plan ? STAGES[u.id].every(st=>stageDone(u.id,st.key)) : u.lessons.every(lessonDone);
// // unitUnlocked：單元是否解鎖。第一個單元永遠開放；其他單元需要「前一個單元完成」
const unitUnlocked = u => { const i=UNITS.indexOf(u); return i===0 || unitDone(UNITS[i-1]); };
// // lessonUnlocked：舊版課程是否解鎖（前一堂課完成才打開）
const lessonUnlocked = (u,lid) => { if(!unitUnlocked(u)) return false; const k=u.lessons.indexOf(lid); return k===0 || lessonDone(u.lessons[k-1]); };
// // unitStatus：單元狀態文字，給首頁顯示徽章用（done 完成 / prog 進行中 / lock 未解鎖）
const unitStatus = u => unitDone(u)?'done':(!unitUnlocked(u)?'lock':'prog');
// // curLevel：目前級別。A1 單元全部完成就變成 A2
const curLevel = () => UNITS.filter(u=>u.level==='A1').every(unitDone)?'A2':'A1';
// // nextLesson：找出「下一個該學的」步驟或課程，首頁的「繼續學習」卡片使用
function nextLesson(){ for(const u of UNITS){ if(u.plan){ const st=STAGES[u.id].find(x=>!stageDone(u.id,x.key)); if(st) return {u,stage:st}; continue; } for(const l of u.lessons) if(!lessonDone(l)) return {u,lid:l}; } return null; }
const nlTitle = nl => nl.stage ? nl.stage.title : LESSONS[nl.lid].title;

/* 詞彙熟悉度（間隔複習：fam 0~5 → 下次複習天數） */
const FAM_DAYS = [0,1,2,4,7,14];
const getV = id => S.vocab[id] || {fam:0,review:false,seen:false,due:0};
function ensureV(id){ if(!S.vocab[id]) S.vocab[id]={fam:0,review:false,seen:false,due:0}; return S.vocab[id]; }
// // markSeen：學生看過某個生詞後，標記為「已看過」並安排第一次複習時間
function markSeen(id){ const s=ensureV(id); if(!s.seen){ s.seen=true; s.fam=Math.max(1,s.fam); s.due=Date.now()+FAM_DAYS[1]*864e5; save(); } }
// // vocabResult：答題後更新單字熟悉度。答對 fam+1，答錯 fam-1 並加入複習清單
function vocabResult(id,ok){ const s=ensureV(id); s.seen=true; if(ok){ s.fam=Math.min(5,s.fam+1); s.due=Date.now()+FAM_DAYS[s.fam]*864e5; } else { s.fam=Math.max(0,s.fam-1); s.review=true; s.due=Date.now(); } }
// // dueVocab：找出「現在該複習」的單字（複習中心使用）
function dueVocab(){ const now=Date.now(); return VOCAB.filter(v=>{ const s=S.vocab[v.id]; return s && (s.review || (s.seen && s.fam<5 && s.due<=now)); }); }
// // wrongList：目前「還沒訂正」的錯題清單（題目找不到的舊紀錄會自動忽略）
const wrongList = () => Object.values(S.wrong).filter(w=>!w.resolved && (LESSONS[w.lid]||STAGEBANK[w.lid]));
const grammarList = () => Object.keys(S.grammar).filter(g=>S.grammar[g] && GRAMMAR[g]);
const speechTodo = () => SPEECH.filter(s=>!(S.speech[s.id] && S.speech[s.id].passes>0));
// // reviewCount：複習中心的待辦總數（錯題 + 單字 + 文法），顯示在導覽列紅點
const reviewCount = () => wrongList().length + dueVocab().length + grammarList().length;

/* =====================================================================
   4. 音訊：優先播放 assets/audio，找不到時改用 Web Speech API
   【功能】播放聲音。先找 assets/audio 裡的 mp3；找不到就用瀏覽器內建語音朗讀。
   【好處】還沒錄音檔也能先測試；之後把 mp3 放進去就自動換成真人錄音。
   ===================================================================== */
// // speakText：用瀏覽器內建語音朗讀一段文字（台灣華語 zh-TW、速度 0.85 較慢）
function speakText(text){ try{ if(!window.speechSynthesis) return; speechSynthesis.cancel(); const u=new SpeechSynthesisUtterance(text); u.lang='zh-TW'; u.rate=.85; speechSynthesis.speak(u); }catch(e){} }
// // playStd：先播放 path 的音檔；播不出來（檔案不存在）就改用 speakText 朗讀 text
function playStd(path, text){
  const a=$('#stdAudio'); let fell=false; const fb=()=>{ if(fell) return; fell=true; speakText(text); };
  try{ a.pause(); }catch(e){}
  if(!path){ fb(); return; }
  a.onerror=fb; a.src=path;
  const p=a.play(); if(p && p.catch) p.catch(fb);
}

/* =====================================================================
   5. 獨立模組：SpeechPracticeModule（語音辨識 + 比對，與畫面渲染分離）
   【功能】口說練習：錄音 → 語音辨識成文字 → 和標準句子逐字比對 → 給通過/不通過。
   【提醒】這一章比較難，且已自成一個模組。一般新增題目/單元【不需要】改這裡。
   【限制】語音辨識需要 Chrome / Edge，且網址是 https 或 localhost。
   ===================================================================== */
const SpeechPracticeModule = (function(){
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  const SIMP = {'学':'學','师':'師','谢':'謝','饭':'飯','车':'車','钱':'錢','个':'個','气':'氣','买':'買','贵':'貴','热':'熱','这':'這','见':'見','对':'對','说':'說','运':'運','们':'們','么':'麼','两':'兩','吗':'嗎','爱':'愛','来':'來','时':'時','会':'會','样':'樣','钟':'鐘','杯':'杯','岁':'歲','点':'點','还':'還','没':'沒','认':'認','识':'識'};
  let rec=null, finalText='', interimText='';
  let cfg={ store:()=>({}), persist:()=>{}, onActivity:()=>{} };
  const api = {
    supported: !!SR,
    configure(c){ cfg=Object.assign(cfg,c); },
    /* 步驟 4：請求麥克風權限 */
    async requestMic(){
      if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) return true;
      try{ const st=await navigator.mediaDevices.getUserMedia({audio:true}); st.getTracks().forEach(x=>x.stop()); return true; }catch(e){ return false; }
    },
    /* 步驟 5~6：開始辨識並回傳即時文字 */
    listen(h){
      finalText=''; interimText='';
      rec=new SR(); rec.lang='zh-TW'; rec.interimResults=true; rec.continuous=false; rec.maxAlternatives=1;
      rec.onstart=()=>h.onState&&h.onState('listening');
      rec.onresult=e=>{ let f='',i=''; for(let k=0;k<e.results.length;k++){ const tr=e.results[k][0].transcript; if(e.results[k].isFinal) f+=tr; else i+=tr; } finalText=f; interimText=i; h.onText&&h.onText(f,i); };
      rec.onerror=e=>{ h.onError&&h.onError(e.error); };
      rec.onend=()=>{ h.onEnd&&h.onEnd((finalText+interimText).trim()); };
      try{ rec.start(); }catch(err){ h.onError&&h.onError('start-failed'); }
    },
    /* 步驟 7：停止錄音，onend 會觸發比對 */
    stop(){ try{ rec&&rec.stop(); }catch(e){} },
    abort(){ try{ if(rec){ rec.onend=null; rec.onerror=null; rec.abort(); } }catch(e){} rec=null; },
    normalize(s){ return Array.from(String(s||'')).map(c=>SIMP[c]||c).filter(c=>!/[\s\u3000-\u303f\uff00-\uffef.,!?;:'"()\-…「」]/.test(c)); },
    /* 步驟 8：逐字（LCS）比對，再彙整成逐詞標示 */
    evaluate(sent,text){
      const tgt=this.normalize(sent.han), rc=this.normalize(text), n=tgt.length, m=rc.length;
      const dp=Array.from({length:n+1},()=>Array(m+1).fill(0));
      for(let i=1;i<=n;i++) for(let j=1;j<=m;j++) dp[i][j]= tgt[i-1]===rc[j-1] ? dp[i-1][j-1]+1 : Math.max(dp[i-1][j],dp[i][j-1]);
      const tm=Array(n).fill(false), rm=Array(m).fill(false); let i=n,j=m;
      while(i>0&&j>0){ if(tgt[i-1]===rc[j-1]){ tm[i-1]=rm[j-1]=true; i--; j--; } else if(dp[i-1][j]>=dp[i][j-1]) i--; else j--; }
      let p=0; const words=sent.words.map(w=>{ const len=Array.from(w).length; const ok=tm.slice(p,p+len).every(Boolean); p+=len; return {w,ok}; });
      const score=n?tm.filter(Boolean).length/n:0;
      return {text, words, score, passed:score>=0.8, extra:rc.filter((c,k)=>!rm[k]).join('')};
    },
    /* 步驟 10：記錄練習次數與通過率 */
    record(sid,passed){ const st=cfg.store(); const r=st[sid]||(st[sid]={attempts:0,passes:0,last:0}); r.attempts++; if(passed) r.passes++; r.last=Date.now(); cfg.persist(); cfg.onActivity(passed); },
    stats(sid){ const r=cfg.store()[sid]||{attempts:0,passes:0}; return {attempts:r.attempts,passes:r.passes,rate:r.attempts?Math.round(r.passes/r.attempts*100):0}; }
  };
  return api;
})();
SpeechPracticeModule.configure({ store:()=>S.speech, persist:save, onActivity:()=>{ touchStreak(); save(); } });

