    }
    $mic.onclick=()=>{ if(state==='listening') M.stop(); else if(state!=='requesting'&&state!=='processing') start(); };
    q('[data-a=model]').onclick=()=>playStd(sent.audio,sent.han);
    q('[data-a=manual]').onclick=()=>{ const v=q('[data-r=manual]').value.trim(); if(!v) return; showLive(v); setState('processing'); finish(v); };
