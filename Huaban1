        <div class="text-xs font-bold text-slate-400 mt-3">${t('sp_compare')}</div>
        <div class="han">${result.words.map(w=>`<span class="wchip ${w.ok?'ok':'bad'}">${w.w}${w.ok?'':' ✗'}</span>`).join('')}</div>
        <div class="text-sm mt-2 text-slate-500">${t('sp_you')}：<span class="han">${result.text}</span>${result.extra?` ｜ ${t('sp_extra')}：<b class="text-amber-600 han">${result.extra}</b>`:''}</div>
        <div class="text-xs text-slate-400 mt-2">${t('sp_att')} ${st.attempts} ・ ${t('sp_rate')} ${st.rate}%</div>
        <div class="flex gap-2 mt-3"><button class="btn btn-blue btn-sm flex-1" data-a="replay">🔊 ${t('sp_replay')}</button><button class="btn btn-ghost btn-sm flex-1" data-a="retry">↻ ${t('sp_retry')}</button></div></div>`;
      $res.querySelector('[data-a=replay]').onclick=()=>playStd(sent.audio,sent.han);
      $res.querySelector('[data-a=retry]').onclick=reset;
    }
    function reset(){ M.abort(); result=null; errored=false; $res.innerHTML=''; showLive(''); setState('idle'); onResult&&onResult(null); }
    async function start(){
      result=null; errored=false; $res.innerHTML=''; showLive(''); onResult&&onResult(null);
      if(!M.supported){ setState('error',t('sp_unsupported')); return; }
      setState('requesting');
      const ok=await M.requestMic(); if(!ok){ setState('error',t('sp_denied')); return; }
      M.listen({
        onState:()=>setState('listening'),
        onText:(f,i)=>showLive(f+i),
        onError:e=>{ errored=true; setState('error', (e==='not-allowed'||e==='service-not-allowed')?t('sp_denied'):(e==='no-speech'?t('sp_nosound'):t('sp_err')+' ('+e+')')); },
        onEnd:txt=>{ if(errored) return; setState('processing'); finish(txt); }
