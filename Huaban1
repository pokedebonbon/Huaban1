    function setState(s,msg){
      state=s; const map={idle:'sp_st_idle',requesting:'sp_st_req',listening:'sp_st_listen',processing:'sp_st_proc',done:'sp_st_done',error:'sp_st_err'};
      $st.className='status '+(s==='listening'?'listening':s==='done'?'done':s==='error'?'error':''); $st.querySelector('span').textContent=msg||t(map[s]);
      $mic.classList.toggle('rec',s==='listening'); $mic.textContent=s==='listening'?'⏹':'🎤';
