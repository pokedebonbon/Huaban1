/* =====================================================================
   7. 課程引擎（Lesson）與各題型渲染器（Q）
   【功能】這是 APP 的「心臟」。給它一串題目，它會一題一題出給學生，並負責：
           顯示題目 → 學生作答 → 批改 → 扣血量/加 XP → 記錄錯題 → 最後顯示成績。
   【兩個部分】
     (1) Lesson：負責「流程」（下一題、上一題、批改、結束）。
     (2) Q：負責「每一種題型長什麼樣子」。Q.mc 是選擇題、Q.fill 是填空…。
   【新增題型時】在 Q 裡新增 Q.名稱 = (box,it)=>{...}，題目就能用 {t:'名稱',...}。
   【一般只是加題目】不用改這章，到「2b」加題目即可。
   ===================================================================== */
// // cur：「目前這一題」的暫存區。每換一題就清空。
// //   cur.ans()  ← 每種題型都要提供：回傳學生目前的答案（還沒作答回傳 null）
// //   cur.lock() ← 每種題型都要提供：批改後把畫面鎖住並標出對錯
let cur = {};
// // NG（Not Graded）：「不計分」的題型 = 教學頁。這些頁面只按「繼續」，不會批改、也不扣血量
const NG = new Set(['vocab','grammar','flip']);

// // itemTitle：把一題變成一小段文字，寫進「錯題清單」給學生複習時辨認
function itemTitle(it){
  if(it.t==='match') return tx(it.q)||t('match_q');
  if(it.t==='order') return tx(it.en);
  if(it.t==='speak'){ const s=SPEECH.find(x=>x.id===it.sid); return s?s.han:''; }
  if(it.t==='fill'||it.t==='type') return it.q.replace('___','＿＿');
  return tx(it.q)||'';
}

// // Lesson：課程引擎。一次練習 = 一個 Lesson。重要的變數 this.s 是「這次練習的狀態」：
// //   entries 題目清單   i 目前第幾題   hp 剩餘血量   res 每題的作答結果   xp 本次經驗值
// // 流程：open(開始) → render(畫出一題) → 學生作答 → main(按鈕) → grade(批改) → go(下一題) → … → finish(結算)
const Lesson = {
  s:null,
  //   // startLesson：開始一堂舊版的課（單元二到五）。把 LESSONS 裡的題目包成 entries 交給 open
  startLesson(lid){
    const l=LESSONS[lid]; if(!l) return;
    this.open({id:lid,title:l.title,real:true,entries:l.items.map((item,i)=>({item,ref:[lid,i],key:lid+':'+i}))});
  },
  //   // open：開始一次練習。cfg 重要欄位：entries(題目清單)、title(標題)、
  //   //   stage（若是 5 步驟流程的步驟才有：記錄單元、步驟代號，完成時用來解鎖下一步）
  //   // 這裡會：建立狀態、血量設成 5、打開練習畫面、隱藏下方導覽列
  open(cfg){
    this.s={cfg,entries:cfg.entries,i:0,hp:5,res:[],xp:0,right:0,graded:0,newWrong:0,vids:new Set(),ended:false,hadWrong:false};
    $('#lessonLayer').classList.add('open'); $('#nav').style.display='none'; $('#lsFoot').style.display='block';
    $('#lsPrev').textContent='← '+t('prev'); this.render();
  },
  //   // render：畫出「目前這一題」。依題目的 t（題型）去呼叫 Q[題型] 把畫面畫出來
  render(){
    const s=this.s, e=s.entries[s.i], it=e.item, r=s.res[s.i];
    SpeechPracticeModule.abort(); try{ speechSynthesis.cancel(); }catch(x){}
    const body=$('#lsBody'); body.scrollTop=0; cur={};
    $('#lsBar').style.width=(s.res.filter(Boolean).length/s.entries.length*100)+'%';
    $('#lsHp').textContent='❤️'.repeat(s.hp)+'🤍'.repeat(5-s.hp);
    body.innerHTML='<div id="qbox"></div>';
    const box=$('#qbox'); if(r&&!r.ng) box.classList.add('locked');
    Q[it.t](box,it,r,e);
    if(r&&r.a&&cur.lock) cur.lock(r.a);
    this.sync();
  },
  //   // sync：同步下方主按鈕與回饋區。例如：還沒作答→按鈕灰色；答完→顯示「下一題」；字卡還沒翻面→不能繼續
  sync(){
    const s=this.s; if(!s||s.ended) return;
    const it=s.entries[s.i].item, r=s.res[s.i], main=$('#lsMain'), last=s.i===s.entries.length-1;
    $('#lsPrev').disabled=s.i===0;
    if(r){ main.disabled=false; main.textContent=last?t('finish'):t('next'); }
    else if(NG.has(it.t)){ main.disabled=(it.t==='flip'&&!cur.flipped); main.textContent=t('cont_btn'); }
    else { main.disabled=!(cur.ans&&cur.ans()); main.textContent=t('check'); }
    main.className='btn flex-1 '+((r&&r.fb&&!r.ok)?'btn-red':'btn-primary');
    const fb=$('#lsFb'); if(r&&r.fb){ fb.className='fb '+(r.ok?'ok':'bad'); fb.innerHTML=r.fb; fb.style.display='block'; } else fb.style.display='none';
  },
  //   // main：按下主按鈕時做的事：已作答→下一題；教學頁→直接下一題；其他→批改
  main(){
    const s=this.s, it=s.entries[s.i].item, r=s.res[s.i];
    if(r){ this.go(1); return; }
    if(NG.has(it.t)){ if(it.t==='vocab'||it.t==='flip') markSeen(it.v); s.res[s.i]={ng:true}; this.go(1); return; }
    const a=cur.ans&&cur.ans(); if(!a) return; this.grade(a);
  },
  //   // skip：略過此題（口說題用，不計分）
  skip(){ const s=this.s; s.res[s.i]={ng:true,skipped:true}; this.go(1); },
  //   // grade：批改。對→加 XP、錯題訂正；錯→扣 1 血、記進錯題清單；同時更新單字熟悉度與進度條
  grade(a){
    const s=this.s, e=s.entries[s.i], it=e.item, ok=!!a.correct;
    s.graded++; S.quiz.t++;
    if(ok){ s.right++; S.quiz.c++; s.xp+=10; if(S.wrong[e.key]) S.wrong[e.key].resolved=true; }
    else {
      s.hp--; s.hadWrong=true;
      if(e.ref){ const prev=S.wrong[e.key]; if(!prev||prev.resolved) s.newWrong++; S.wrong[e.key]={key:e.key,lid:e.ref[0],idx:e.ref[1],q:itemTitle(it),ans:a.ans,count:(prev?prev.count:0)+1,resolved:false,at:Date.now()}; }
      else s.newWrong++;
      if(it.v) s.vids.add(it.v);
    }
    if(it.v) vocabResult(it.v,ok);
    const exp=tx(it.exp);
    const fb= ok ? `<b>${t('correct')}</b>${exp?`<div class="sm">${exp}</div>`:''}`
                 : `<b>✗ ${t('wrong')}</b><div>${t('right_ans')}<span class="han">${a.ans}</span></div>${exp?`<div class="sm">${exp}</div>`:''}`;
    s.res[s.i]={ok,fb,a}; save();
    if(cur.lock) cur.lock(a);
    $('#qbox').classList.add('locked');
    $('#lsHp').textContent='❤️'.repeat(Math.max(0,s.hp))+'🤍'.repeat(5-Math.max(0,s.hp));
    $('#lsBar').style.width=(s.res.filter(Boolean).length/s.entries.length*100)+'%';
    this.sync();
  },
  //   // go：換題。d=1 下一題、d=-1 上一題。最後一題（或血量用完）就進入 finish 結算
  go(d){
    const s=this.s;
    if(d>0){ if(s.hp<=0&&s.res[s.i]) return this.finish(true); if(s.i>=s.entries.length-1) return this.finish(false); s.i++; }
    else if(s.i>0) s.i--;
    this.render();
  },
  //   // finish：結算。算正確率 → 發 XP → 若是 5 步驟流程的步驟且沒有血量用完，就記錄「已完成」
  //   //   （S.stages）並解鎖下一步 → 存進歷史紀錄 → 顯示成績畫面
  //   //   教學步驟（字卡、文法說明）沒有計分題，所以不顯示成績數字，只顯示「已解鎖下一步」
  finish(hpOut){
    const s=this.s; s.ended=true; SpeechPracticeModule.abort();
    if(!hpOut) s.xp+=5;
    const acc=s.graded?Math.round(s.right/s.graded*100):100;
    addXp(s.xp);
    if(s.cfg.stage && !hpOut){ const k=s.cfg.stage.u+':'+s.cfg.stage.key, old=S.stages[k]; S.stages[k]={acc:Math.max(acc,old?old.acc:0),at:Date.now()}; }
    if(s.cfg.stage && s.hadWrong && s.cfg.stage.gids) s.cfg.stage.gids.forEach(g=>{ S.grammar[g]=true; });
    if(s.cfg.real){
      if(!hpOut){ const old=S.done[s.cfg.id]; S.done[s.cfg.id]={acc:Math.max(acc,old?old.acc:0),at:Date.now()}; S.lastLesson=s.cfg.id; }
      if(s.hadWrong) s.entries.forEach(e=>{ if(e.item.t==='grammar') S.grammar[e.item.gid]=true; });
    }
    S.history.unshift({t:Date.now(),title:s.cfg.title,acc,xp:s.xp,right:s.right,total:s.graded,hpOut}); S.history=S.history.slice(0,30); save();
    const vlist=[...s.vids].map(id=>vById(id)).filter(Boolean);
    const glist=s.cfg.real&&s.hadWrong?s.entries.filter(e=>e.item.t==='grammar').map(e=>e.item):[];
    $('#lsFoot').style.display='none'; $('#lsBar').style.width='100%';
    $('#lsBody').innerHTML=`<div class="text-center pt-6">
      <div style="font-size:72px">${hpOut?'💔':(acc>=80?'🏆':'🎉')}</div>
      <h2 class="text-3xl font-black mt-2">${hpOut?t('hp_out'):t('lesson_done')}</h2>
      ${s.cfg.stage&&!hpOut&&s.cfg.stage.after?`<div class="card p-4 mt-6 font-bold">${tx(s.cfg.stage.after)}</div>`:''}
      <div class="grid grid-cols-2 gap-3 mt-6 text-left" ${s.graded===0?'style="display:none"':''}>
        <div class="card p-4"><div class="text-xs font-bold text-slate-400">${t('correct_cnt')}</div><div class="text-2xl font-black text-green-600">${s.right}</div></div>
        <div class="card p-4"><div class="text-xs font-bold text-slate-400">${t('total_q')}</div><div class="text-2xl font-black">${s.graded}</div></div>
        <div class="card p-4"><div class="text-xs font-bold text-slate-400">${t('accuracy')}</div><div class="text-2xl font-black text-sky-500">${acc}%</div></div>
        <div class="card p-4"><div class="text-xs font-bold text-slate-400">${t('xp_gain')}</div><div class="text-2xl font-black text-amber-500">+${s.xp}</div></div>
        <div class="card p-4 col-span-2"><div class="text-xs font-bold text-slate-400">${t('new_wrong')}</div><div class="text-2xl font-black text-red-500">${s.newWrong}</div></div>
      </div>
      ${(vlist.length||glist.length)?`<div class="card p-4 mt-4 text-left"><div class="font-black mb-2">📌 ${t('suggest')}</div>
        ${vlist.map(v=>`<span class="chip han" style="display:inline-block;margin:3px;font-size:14px">${v.han} <small>${v.py}</small></span>`).join('')}
        ${glist.map(g=>`<div class="text-sm mt-2">📘 ${tx(g.title)}</div>`).join('')}</div>`:''}
      <div class="grid gap-3 mt-6 pb-6">
        ${hpOut?`<button class="btn btn-blue" id="lsRetry">${t('retry')}</button>`:''}
        <button class="btn btn-primary" id="lsBack">${s.cfg.stage?t('back_unit'):t('back_map')}</button></div></div>`;
    $('#lsBack').onclick=()=>this.close();
    if(hpOut) $('#lsRetry').onclick=()=>{ const cfg=s.cfg; cfg.entries=s.entries; this.open(cfg); };
  },
  //   // exit：按左上角 ✕。還沒結束時先跳出「確定要離開嗎？」
  exit(){
    if(this.s&&this.s.ended){ this.close(); return; }
    Modal.confirm({title:t('exit_title'),body:t('exit_body'),ok:t('leave'),cancel:t('stay'),onOk:()=>this.close()});
  },
  //   // close：關閉練習畫面。若是 5 步驟流程的步驟，會回到「單元首頁」；否則回首頁
  close(){ SpeechPracticeModule.abort(); try{speechSynthesis.cancel();}catch(e){} $('#lessonLayer').classList.remove('open'); $('#nav').style.display='flex'; const cfg=this.s&&this.s.cfg; this.s=null; App.render(); if(cfg&&cfg.stage) App.openUnit(cfg.stage.u); }
};

/* ---- 題型渲染器 ---- */
// // Q：每一種題型的「畫面 + 批改規則」。題目的 t 是什麼，就會用 Q[t] 來畫。
// // 每個 Q.xxx = (box, it) => { ... } 拿到兩樣東西：
// //   box：要把畫面放進去的空盒子      it：這一題的資料（STAGEBANK 裡寫的那一筆）
// // 作答型題型最後必須設定：cur.ans = ()=>({correct:是否答對, user:學生答案, ans:正確答案文字})
// //                          cur.lock = ()=>{...} 批改後鎖定畫面並標示對錯
// // 教學型題型（vocab / flip / grammar）不需要 cur.ans，因為它們不計分。
const Q = {};

// // Q.vocab：舊版「生詞卡」（單元二到五使用）。顯示漢字、拼音、意思、例句
Q.vocab = (box,it) => {
  const v=vById(it.v);
  box.innerHTML=`<div class="text-center pt-2">
    <span class="badge b-prog">${t('new_word')}</span>
    <div class="han mt-4" style="font-size:68px;font-weight:900;line-height:1.1">${v.han}</div>
    <div class="text-2xl text-sky-500 font-bold mt-2">${v.py}</div>
    <div class="mt-2"><span class="badge b-done">${v.pos}</span></div>
    <div class="text-xl font-bold mt-3">${v.en}</div>
    <!-- 【標準語音錄音放置區】${v.audio} -->
    <button class="btn btn-blue mt-4" id="vPlay">🔊 ${t('sp_listen')}</button>
    <div class="card p-4 mt-6 text-left"><div class="han text-lg font-bold">${v.ex}</div><div class="text-sm text-slate-500">${v.exPy}</div><div class="text-sm text-slate-400">${v.exEn}</div></div></div>`;
  $('#vPlay').onclick=()=>playStd(v.audio,v.han);
};

