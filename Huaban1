    }
    function showLive(txt){ $live.textContent=txt||'—'; }
    function finish(text){
      if(!text){ setState('error',t('sp_nosound')); return; }
      result=M.evaluate(sent,text); M.record(sent.id,result.passed); setState('done'); renderResult(); onResult&&onResult(result);
    }
    function renderResult(){
      const st=M.stats(sent.id), pct=Math.round(result.score*100);
      $res.innerHTML=`<div class="card p-4 mb-3">
