    <div class="flex gap-3 mt-3"><button class="btn btn-ghost flex-1" ${App.spIdx===0?'disabled':''} onclick="App.spIdx--;App.render()">← ${t('sp_prevS')}</button><button class="btn btn-primary flex-1" ${App.spIdx===SPEECH.length-1?'disabled':''} onclick="App.spIdx++;App.render()">${t('sp_nextS')} →</button></div></div>`;
};

// // View.review：複習中心。顯示錯題、不熟的單字、需重練的文法、尚未完成的口說，以及答題統計
View.review = () => {
  const wl=wrongList(), vl=dueVocab(), gl=grammarList(), sl=speechTodo();
  const sec=(title,count,btn,body)=>`<div class="card p-4"><div class="flex items-center justify-between mb-2"><div class="font-black">${title} <span class="badge b-prog">${count}</span></div>${btn||''}</div>${body}</div>`;
  const empty=`<div class="text-sm text-slate-400 py-2">${t('empty')}</div>`;
  const seen=VOCAB.filter(v=>getV(v.id).seen), dist=[0,1,2,3,4,5].map(n=>seen.filter(v=>getV(v.id).fam===n).length);
  const mx=Math.max(1,...dist);
  return `<div class="p-4 grid gap-3"><h1 class="text-2xl font-black">🔁 ${t('review_title')}</h1>
  ${sec('❌ '+t('sec_wrong'),wl.length,wl.length?`<button class="btn btn-primary btn-sm" onclick="App.reviewWrong()">${t('restart')}</button>`:'',
    wl.length?wl.map(w=>`<div class="py-2" style="border-top:1px solid #eee"><div class="han font-bold">${w.q}</div><div class="text-xs text-slate-500">${t('right_ans')}<span class="han">${w.ans}</span> ・ ${w.count} ${t('times')}</div><button class="btn btn-ghost btn-sm mt-1" onclick="App.resolveWrong('${w.key}')">✓ ${t('mark_known')}</button></div>`).join(''):empty)}
  ${sec('📒 '+t('sec_vocab'),vl.length,vl.length?`<button class="btn btn-primary btn-sm" onclick="App.reviewVocab()">${t('restart')}</button>`:'',
    vl.length?vl.map(v=>{ const s=getV(v.id); return `<div class="py-2 flex items-center gap-3" style="border-top:1px solid #eee"><div class="flex-1"><span class="han font-black text-lg">${v.han}</span> <span class="text-sky-500 text-sm">${v.py}</span><div class="text-xs text-slate-500">${v.en} ・ <span class="text-amber-500">${stars(s.fam)}</span> ${s.review?'🔖':''}</div></div><button class="btn btn-ghost btn-sm" onclick="App.knowVocab('${v.id}')">✓</button></div>`; }).join(''):empty)}
  ${sec('📘 '+t('sec_grammar'),gl.length,gl.length?`<button class="btn btn-primary btn-sm" onclick="App.reviewGrammar()">${t('restart')}</button>`:'',
    gl.length?gl.map(g=>`<div class="py-2 flex items-center gap-3" style="border-top:1px solid #eee"><div class="flex-1 font-bold">${tx(GRAMMAR[g].title)}</div><button class="btn btn-ghost btn-sm" onclick="App.knowGrammar('${g}')">✓ ${t('mark_known')}</button></div>`).join(''):empty)}
  ${sec('🎤 '+t('sec_speech'),sl.length,'',
    sl.length?sl.map(s=>`<div class="py-2 flex items-center gap-3" style="border-top:1px solid #eee"><div class="flex-1"><div class="han font-bold">${s.han}</div><div class="text-xs text-slate-500">${s.py}</div></div><button class="btn btn-blue btn-sm" onclick="App.spIdx=${SPEECH.indexOf(s)};App.go('speech')">${t('start')}</button></div>`).join(''):empty)}
  <div class="card p-4"><div class="font-black mb-2">📊 ${t('sec_hist')}</div>
    <div class="text-sm text-slate-500">${t('quiz_total')}：${S.quiz.t}（✓ ${S.quiz.c} / ✗ ${S.quiz.t-S.quiz.c}）</div>
    <div class="text-xs font-bold text-slate-400 mt-3 mb-1">${t('fam_dist')}</div>
    <div class="flex items-end gap-2" style="height:70px">${dist.map((n,i)=>`<div class="flex-1 text-center text-xs"><div style="height:${Math.max(4,n/mx*48)}px;background:var(--g);border-radius:6px 6px 0 0"></div>${i}★<br><b>${n}</b></div>`).join('')}</div>
    ${S.history.slice(0,5).map(h=>`<div class="text-xs text-slate-500 py-1" style="border-top:1px solid #eee"><span class="han">${tx(h.title)}</span> ・ ${h.acc}% ・ +${h.xp}XP ・ ${dstr(h.t)}</div>`).join('')}</div>
  </div>`;
};

// // View.profile：個人中心。顯示各種統計、切換語言、清除紀錄
View.profile = () => {
  const units=UNITS.filter(unitDone).length, lessons=Object.keys(S.done).length;
  const seen=VOCAB.filter(v=>getV(v.id).seen).length, acc=S.quiz.t?Math.round(S.quiz.c/S.quiz.t*100)+'%':'—';
  const sp=Object.values(S.speech).reduce((a,r)=>a+r.attempts,0);
  const cell=(l,v)=>`<div class="card p-3"><div class="text-xs font-bold text-slate-400">${l}</div><div class="text-xl font-black">${v}</div></div>`;
  return `<div class="p-4 grid gap-4"><div class="text-center pt-2"><div style="font-size:56px">🧑‍🎓</div><h1 class="text-2xl font-black">${t('profile_title')}</h1></div>
    <div class="grid grid-cols-2 gap-3">
      ${cell(t('s_level'),curLevel())}${cell(t('s_units'),units+'/'+UNITS.length)}${cell(t('s_lessons'),lessons+'/'+Object.keys(LESSONS).length)}${cell(t('s_xp'),'⭐ '+S.xp)}
      ${cell(t('s_streak'),'🔥 '+streakNow()+' '+t('days'))}${cell(t('s_vocab'),seen+'/'+VOCAB.length)}${cell(t('s_acc'),acc)}${cell(t('s_speech'),sp)}</div>
    <div class="card p-4"><div class="font-black mb-2">🌐 ${t('lang')}</div><div class="flex gap-3"><button class="btn flex-1 ${S.lang==='zh'?'btn-primary':'btn-ghost'}" onclick="App.setLang('zh')">繁體中文</button><button class="btn flex-1 ${S.lang==='en'?'btn-primary':'btn-ghost'}" onclick="App.setLang('en')">English</button></div></div>
    <div class="card p-4"><div class="font-black mb-2">🕒 ${t('recent_hist')}</div>
      ${S.history.length?S.history.slice(0,8).map(h=>`<div class="py-2 text-sm flex justify-between" style="border-top:1px solid #eee"><span class="han">${h.hpOut?'💔 ':'✅ '}${tx(h.title)}</span><span class="text-slate-500">${h.acc}% ・ +${h.xp}XP</span></div>`).join(''):`<div class="text-sm text-slate-400">${t('no_hist')}</div>`}</div>
    <button class="btn btn-red" onclick="App.clearData()">🗑️ ${t('clear_data')}</button></div>`;
};

/* =====================================================================
   9. App 控制器
   【功能】APP 的「總指揮」：切換頁面、打開單元首頁、開始某個步驟、複習、切換語言、清除資料。
   【最後幾行】把按鈕接上功能，並第一次顯示首頁（App.render()）。
   ===================================================================== */
// // App：總指揮。App.view 是目前在哪一頁；App.render() 會依 App.view 重畫畫面
const App = {
  view:'home', spIdx:0, vf:{lv:'all',u:'all',q:''},
  //   // go：切換頁面。App.go('vocab') 就會到詞彙庫
  go(v){ SpeechPracticeModule.abort(); this.view=v; this.render(); window.scrollTo(0,0); },
  //   // render：重畫目前頁面與下方導覽列。資料有變動時呼叫它，畫面就會更新
  render(){
    SpeechPracticeModule.abort();
    $('#view').innerHTML=View[this.view]();
    if(this.view==='vocab') this.drawVocab();
    if(this.view==='speech') SpeechUI.mount($('#spMount'),SPEECH[this.spIdx],res=>{ if(res&&res.passed){ addXp(3); } this.refreshSpeechChips(); });
    this.renderNav();
  },
  refreshSpeechChips(){ /* 練習完成後更新章節 ✓ 標記，不重繪錄音區 */
    const chips=document.querySelectorAll('#view .overflow-x-auto .chip');
    chips.forEach((c,i)=>{ const st=SpeechPracticeModule.stats(SPEECH[i].id); c.textContent=(i+1)+(st.passes>0?' ✓':''); });
  },
  //   // renderNav：畫下方五個導覽按鈕（學習、詞彙、口說、複習、我的）。想新增分頁就改這裡 + View
  renderNav(){
    const tabs=[['home','🏠','nav_home'],['vocab','📖','nav_vocab'],['speech','🎤','nav_speech'],['review','🔁','nav_review'],['profile','🧑','nav_me']];
    $('#nav').innerHTML=tabs.map(([id,ic,k])=>`<button class="navbtn ${this.view===id?'on':''}" onclick="App.go('${id}')"><span>${ic}</span>${t(k)}${id==='review'&&reviewCount()?` <b style="color:var(--r)">•</b>`:''}</button>`).join('');
  },
  //   // drawVocab：依篩選條件重畫「詞彙庫」的單字清單
  drawVocab(){
    const f=this.vf, q=f.q.trim(), pq=plain(q);
    const list=VOCAB.filter(v=>(f.lv==='all'||v.lv===f.lv)&&(f.u==='all'||String(v.u)===String(f.u))&&(!q||v.han.includes(q)||plain(v.py).includes(pq)||v.en.toLowerCase().includes(q.toLowerCase())||v.ex.includes(q)));
    $('#vList').innerHTML=list.length?list.map(v=>{ const s=getV(v.id), pct=s.fam*20;
      return `<div class="card p-4">
        <div class="flex items-start justify-between"><div><span class="han" style="font-size:34px;font-weight:900">${v.han}</span> <span class="badge b-done">${v.pos}</span><div class="text-sky-500 font-bold">${v.py}</div></div>
          <!-- 【標準語音錄音放置區】${v.audio} -->
          <button class="btn btn-blue btn-sm" onclick="App.playVocab('${v.id}')">🔊</button></div>
        <div class="font-bold mt-1">${v.en}</div>
        <div class="mt-2 p-2 rounded-xl" style="background:#f7f9f4"><div class="han">${v.ex}</div><div class="text-xs text-slate-500">${v.exPy}</div><div class="text-xs text-slate-400">${v.exEn}</div></div>
        <div class="flex items-center gap-3 mt-3"><div class="flex-1"><div class="text-xs text-slate-400">${t('fam')} <span class="text-amber-500">${stars(s.fam)}</span> ${pct}%</div><div class="bar" style="height:8px"><div class="barfill gold" style="width:${pct}%"></div></div></div>
          <button class="btn ${s.review?'btn-ghost':'btn-primary'} btn-sm" onclick="App.toggleReview('${v.id}')">${s.review?t('in_review'):'＋ '+t('add_review')}</button></div></div>`; }).join(''):`<div class="text-center text-slate-400 py-8">${t('no_result')}</div>`;
  },
  playVocab(id){ const v=vById(id); playStd(v.audio,v.han); },
  toggleReview(id){ const s=ensureV(id); s.review=!s.review; if(s.review) s.due=Math.min(s.due||Date.now(),Date.now()); save(); this.drawVocab(); this.renderNav(); },
  startLesson(lid){ Lesson.startLesson(lid); },
  /* ---- 單元首頁：依序解鎖的學習步驟 ---- */
  //   // openUnit：★打開「單元首頁」，把這個單元的 5 個步驟依序列出。
  //   //   已完成 ✓ 綠色；目前可做 ▶ 藍色；尚未解鎖 🔒 灰色（點了會提示「請先完成上一步」）
  //   //   步驟名稱與順序來自 STAGES；題目數量來自 STAGEBANK
  openUnit(id){
    const u=unitById(id); if(!unitUnlocked(u)) return this.toast(t('locked_msg'));
    const st=STAGES[id], dn=stageDoneCount(id), all=dn===st.length; let lastG=null;
    const rows=st.map((s,i)=>{
      const un=stageUnlocked(id,i), d=stageDone(id,s.key), isCur=un&&!d, rec=S.stages[id+':'+s.key], n=STAGEBANK[s.id].items.length;
      const head=s.group!==lastG?`<div class="text-sm font-black text-slate-500 mt-4 mb-1">${tx(s.group)}</div>`:''; lastG=s.group;
      const badge=d?`<span class="badge b-done">✓ ${rec.acc}%</span>`:isCur?`<span class="badge b-prog">▶ ${t('step_start')}</span>`:`<span class="badge b-lock">🔒</span>`;
      return head+`<button class="lnode stg ${d?'done':isCur?'cur':'lock'}" onclick="${un?`App.startStage(${id},'${s.key}')`:`App.toast('${t('stage_lock')}')`}">
        <span class="dot">${d?'✓':un?s.icon:'🔒'}</span>
        <span class="flex-1"><span class="block font-black">${tx(s.title)}</span><span class="block text-xs text-slate-500 font-semibold">${tx(s.desc)} ・ ${n}</span></span>${badge}</button>`;
    }).join('<div class="connector" style="height:10px"></div>');
    $('#unitLayer').innerHTML=`<div class="hdr text-white p-4" style="border-radius:0 0 28px 28px">
        <div class="flex items-center gap-3"><button class="btn btn-ghost btn-sm" onclick="App.closeUnit()">✕</button>
        <div class="flex-1"><div class="text-xs font-bold" style="opacity:.9">${t('unit')} ${u.id} ・ ${u.level}</div><div class="font-black text-xl">${u.emoji} ${S.lang==='zh'?u.zh:u.en}</div></div></div>
        <div class="bar mt-3" style="background:rgba(255,255,255,.3)"><div class="barfill gold" style="width:${dn/st.length*100}%"></div></div>
        <div class="text-xs font-bold mt-1" style="opacity:.95">${dn}/${st.length} ・ ${t('hub_hint')}</div></div>
      <div class="flex-1 overflow-y-auto px-4 pb-8">${all?`<div class="card p-4 mt-4 text-center font-black" style="background:#d7ffb8;border-color:#b5ec86">${t('hub_done')}</div>`:''}${rows}</div>`;
    $('#unitLayer').classList.add('open'); $('#nav').style.display='none';
  },
  //   // closeUnit：關閉單元首頁，回到首頁
  closeUnit(){ $('#unitLayer').classList.remove('open'); $('#nav').style.display='flex'; this.render(); },
  //   // startStage：★開始某個步驟。從 STAGEBANK 取出題目，包成 entries 交給 Lesson.open。
  //   //   uid 是單元編號，key 是步驟代號（vl / vp / gl / gp / rd）
  startStage(uid,key){
    const list=STAGES[uid], s=list.find(x=>x.key===key), i=list.indexOf(s);
    if(!stageUnlocked(uid,i)) return this.toast(t('stage_lock'));
    const entries=STAGEBANK[s.id].items.map((item,k)=>({item,ref:[s.id,k],key:s.id+':'+k}));
    Lesson.open({id:s.id,title:s.title,real:false,stage:{u:uid,key,gids:s.gids,after:s.after},entries});
  },
  toast(msg){ const d=document.createElement('div'); d.textContent=msg; d.style.cssText='position:fixed;left:50%;bottom:100px;transform:translateX(-50%);background:#333;color:#fff;padding:10px 18px;border-radius:99px;font-weight:700;z-index:70;font-size:14px'; document.body.appendChild(d); setTimeout(()=>d.remove(),1800); },
  /* 複習中心動作 */
  //   // 以下三個 review 開頭的函式：從複習中心「重新開始練習」，把錯題／單字／文法再出一次
  reviewWrong(){
    const entries=wrongList().map(w=>{ const l=LESSONS[w.lid]||STAGEBANK[w.lid]; const item=l&&l.items[w.idx]; return item?{item,ref:[w.lid,w.idx],key:w.key}:null; }).filter(Boolean);
    if(!entries.length) return this.toast(t('nothing'));
    Lesson.open({id:'review',title:L('錯題複習','Mistake review'),real:false,entries});
  },
  reviewVocab(){
    const list=shuffle(dueVocab()).slice(0,10); if(!list.length) return this.toast(t('nothing'));
    const entries=list.map(v=>{ const others=shuffle(VOCAB.filter(x=>x.id!==v.id&&x.en!==v.en)).slice(0,3).map(x=>x.en); const opts=shuffle([v.en,...others]);
      return {key:'vq:'+v.id,item:{t:'mc',q:L(`「${v.han}」（${v.py}）是什麼意思？`,`What does 「${v.han}」 (${v.py}) mean?`),opts,ans:opts.indexOf(v.en),exp:L(`${v.han} = ${v.en}`,`${v.han} = ${v.en}`),v:v.id}}; });
    Lesson.open({id:'review',title:L('詞彙複習','Vocabulary review'),real:false,entries});
  },
  reviewGrammar(){
    const entries=grammarList().map(g=>({key:'g:'+g,item:GRAMMAR[g]})); if(!entries.length) return this.toast(t('nothing'));
    Lesson.open({id:'review',title:L('語法複習','Grammar review'),real:false,entries});
  },
  resolveWrong(k){ if(S.wrong[k]){ S.wrong[k].resolved=true; save(); this.render(); } },
  knowVocab(id){ const s=ensureV(id); s.review=false; s.seen=true; s.fam=5; s.due=Date.now()+FAM_DAYS[5]*864e5; save(); this.render(); },
  knowGrammar(g){ S.grammar[g]=false; save(); this.render(); },
  //   // setLang：切換介面語言（zh / en）
  setLang(l){ S.lang=l; save(); document.documentElement.lang=l==='zh'?'zh-Hant':'en'; this.render(); },
  //   // clearData：清除所有學習紀錄（會先跳出確認視窗）
  clearData(){
    Modal.confirm({title:t('confirm_title'),body:t('confirm_body'),ok:t('confirm_ok'),cancel:t('cancel'),onOk:()=>{
      try{ localStorage.removeItem(STORE_KEY); }catch(e){}
      const lang=S.lang; S=defaults(); S.lang=lang; save(); this.view='home'; this.render(); this.toast('✓');
    }});
  }
};

// // ── 程式的最後：把按鈕接上功能，然後第一次畫出首頁 ──
$('#lsExit').onclick=()=>Lesson.exit();
$('#lsPrev').onclick=()=>Lesson.go(-1);
$('#lsMain').onclick=()=>Lesson.main();
document.documentElement.lang = S.lang==='zh'?'zh-Hant':'en';
App.render();
</script>
</body>
</html>
