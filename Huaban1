// // Q.mc：單選題。也同時給聽力題(listen)與閱讀題(read)使用（它們只是多一個播放鈕或短文）
Q.mc = (box,it,r) => {
  let head='';
  if(it.t==='listen') head=`<div class="text-center my-4"><div class="text-sm text-slate-500 mb-2">${t('listen_q')}</div><button class="btn btn-blue" id="lPlay" style="font-size:28px;padding:20px 34px">🔊</button></div>`;
  if(it.t==='read') head=`<div class="card p-4 mb-3"><div class="han text-xl leading-relaxed">${it.passage}</div><details class="mt-2"><summary>${t('pinyin')}</summary><div class="text-sm text-slate-500 mt-1">${it.pinyin}</div></details></div>`;
  box.innerHTML=`${head}<h2 class="qtitle">${tx(it.q)}</h2><div class="grid gap-3">${it.opts.map((o,i)=>`<button class="opt han" data-i="${i}">${o}</button>`).join('')}</div>`;
  if(it.t==='listen'){ $('#lPlay').onclick=()=>playStd(it.audio,it.say); }
  cur.sel=null;
  box.querySelectorAll('.opt').forEach(b=>b.onclick=()=>{ cur.sel=+b.dataset.i; box.querySelectorAll('.opt').forEach(x=>x.classList.toggle('sel',x===b)); Lesson.sync(); });
  cur.ans=()=>cur.sel==null?null:{correct:cur.sel===it.ans,user:it.opts[cur.sel],ans:it.opts[it.ans],sel:cur.sel};
  cur.lock=a=>box.querySelectorAll('.opt').forEach((b,i)=>{ b.classList.remove('sel'); if(i===it.ans) b.classList.add('ok'); else if(i===a.sel) b.classList.add('bad'); });
};
Q.listen = Q.mc; Q.read = Q.mc;

// // Q.multi：多選題。必須「選到的」和「正確答案」完全一致才算對
Q.multi = (box,it) => {
  box.innerHTML=`<h2 class="qtitle">${tx(it.q)}</h2><div class="grid gap-3">${it.opts.map((o,i)=>`<button class="opt han" data-i="${i}">${o}</button>`).join('')}</div>`;
  cur.set=new Set();
  box.querySelectorAll('.opt').forEach(b=>b.onclick=()=>{ const i=+b.dataset.i; if(cur.set.has(i)) cur.set.delete(i); else cur.set.add(i); b.classList.toggle('sel',cur.set.has(i)); Lesson.sync(); });
  const key=a=>[...a].sort().join(',');
  cur.ans=()=>cur.set.size?{correct:key(cur.set)===key(it.ans),user:[...cur.set].map(i=>it.opts[i]).join('、'),ans:it.ans.map(i=>it.opts[i]).join('、'),sel:[...cur.set]}:null;
  cur.lock=a=>box.querySelectorAll('.opt').forEach((b,i)=>{ b.classList.remove('sel'); const should=it.ans.includes(i), chose=(a.sel||[]).includes(i); if(should) b.classList.add('ok'); else if(chose) b.classList.add('bad'); });
};

// // Q.match：配對題。左右兩欄打亂；先點左邊再點右邊。全部配完才能繼續；中途配錯過就不算全對
Q.match = (box,it,r) => {
  const Ls=shuffle(it.pairs.map((p,i)=>({i,x:p[0]}))), Rs=shuffle(it.pairs.map((p,i)=>({i,x:p[1]})));
  box.innerHTML=`<h2 class="qtitle">${tx(it.q)||t('match_q')}</h2><div class="text-sm text-slate-500 mb-3">${t('match_q')}</div>
    <div class="grid grid-cols-2 gap-3"><div class="grid gap-3" data-c="L">${Ls.map(o=>`<button class="opt han" data-i="${o.i}">${o.x}</button>`).join('')}</div>
    <div class="grid gap-3" data-c="R">${Rs.map(o=>`<button class="opt han" data-j="${o.i}">${o.x}</button>`).join('')}</div></div>`;
  cur.left=null; cur.done=new Set(); cur.miss=0;
  const lb=box.querySelectorAll('[data-i]'), rb=box.querySelectorAll('[data-j]');
  lb.forEach(b=>b.onclick=()=>{ if(b.disabled) return; cur.left=+b.dataset.i; lb.forEach(x=>x.classList.toggle('sel',x===b)); });
  rb.forEach(b=>b.onclick=()=>{
    if(b.disabled||cur.left==null) return; const j=+b.dataset.j, i=cur.left;
    if(i===j){ cur.done.add(i); b.classList.add('ok'); b.disabled=true; lb.forEach(x=>{ if(+x.dataset.i===i){ x.classList.remove('sel'); x.classList.add('ok'); x.disabled=true; } }); }
    else { cur.miss++; b.classList.add('bad'); setTimeout(()=>b.classList.remove('bad'),450); lb.forEach(x=>x.classList.remove('sel')); }
    cur.left=null; Lesson.sync();
  });
  cur.ans=()=>cur.done.size===it.pairs.length?{correct:cur.miss===0,user:cur.miss+' ✗',ans:it.pairs.map(p=>p[0]+' ＝ '+p[1]).join('；')}:null;
  cur.lock=()=>{ box.querySelectorAll('.opt').forEach(b=>{ b.classList.remove('sel'); b.classList.add('ok'); }); };
};

// // Q.fill：填空題。題目中的 ___ 會變成空格，點下方的詞放進去
Q.fill = (box,it) => {
  box.innerHTML=`<h2 class="qtitle">${t('fill_q')}</h2>
    <div class="card p-5 han text-2xl text-center mb-5" style="line-height:1.8">${it.q.replace('___','<span class="blank" id="blank">＿＿</span>')}</div>
    <div class="flex flex-wrap gap-3 justify-center">${it.opts.map((o,i)=>`<button class="chip han" data-i="${i}">${o}</button>`).join('')}</div>`;
  cur.sel=null;
  box.querySelectorAll('.chip').forEach(b=>b.onclick=()=>{ cur.sel=it.opts[+b.dataset.i]; $('#blank').textContent=cur.sel; box.querySelectorAll('.chip').forEach(x=>x.classList.toggle('sel',x===b)); Lesson.sync(); });
  cur.ans=()=>cur.sel==null?null:{correct:cur.sel===it.ans,user:cur.sel,ans:it.ans,sel:cur.sel};
  cur.lock=a=>{ const bl=$('#blank'); if(bl){ bl.textContent=a.sel||it.ans; bl.style.color=a.correct?'#46a302':'#ea2b2b'; bl.style.borderColor=a.correct?'#58cc02':'#ff4b4b'; } };
};

// // Q.type：輸入題。學生打字回答，漢字或拼音都可以（會忽略聲調與空格）
Q.type = (box,it) => {
  box.innerHTML=`<h2 class="qtitle">${t('type_q')}</h2>
    <div class="card p-5 han text-2xl text-center mb-4" style="line-height:1.8">${it.q.replace('___','<span class="blank">＿＿</span>')}${it.hint?`<div class="text-sm text-slate-400 mt-1">💡 ${it.hint}</div>`:''}</div>
    <input id="tin" class="inp han" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="${t('type_ph')}">`;
  const inp=$('#tin'); inp.oninput=()=>Lesson.sync();
  inp.onkeydown=e=>{ if(e.key==='Enter'){ const m=$('#lsMain'); if(!m.disabled) m.click(); } };
  cur.ans=()=>{ const v=inp.value.trim(); if(!v) return null; const ok=it.ans.some(x=>plain(x)===plain(v)); return {correct:ok,user:v,ans:it.ans[0]+(it.ans[1]?'（'+it.ans[2]+'）':'')}; };
  cur.lock=a=>{ inp.disabled=true; inp.style.borderColor=a.correct?'#58cc02':'#ff4b4b'; };
};

// // Q.order：排序題。點詞牌排出句子；再點一次可以退回。tokens 是正確的詞，extra 是干擾詞
Q.order = (box,it) => {
  const tokens=shuffle(it.tokens.concat(it.extra||[])), placed=[];
  box.innerHTML=`<h2 class="qtitle">${t('order_q')}</h2><div class="card p-4 mb-3 text-lg font-bold">${tx(it.en)}</div><div id="oAns" class="tray han"></div><div id="oBank" class="bank han"></div>`;
  const tok=k=>`<button class="tok" data-k="${k}">${tokens[k]}${it.py&&it.py[tokens[k]]?`<small>${it.py[tokens[k]]}</small>`:''}</button>`;
  function draw(){
    $('#oAns').innerHTML=placed.map(tok).join('');
    $('#oBank').innerHTML=tokens.map((w,k)=>placed.includes(k)?`<span class="tok ghost">${w}</span>`:tok(k)).join('');
    box.querySelectorAll('.tok[data-k]').forEach(b=>b.onclick=()=>{ const k=+b.dataset.k, p=placed.indexOf(k); if(p>=0) placed.splice(p,1); else placed.push(k); draw(); Lesson.sync(); });
  }
  draw();
  cur.ans=()=>{ if(!placed.length) return null; const u=placed.map(k=>tokens[k]).join(''); return {correct:u===it.ans,user:u,ans:it.ans}; };
};

// // Q.speak：發音題。使用口說模組(SpeechUI)錄音比對；也可以按「略過」不計分
Q.speak = (box,it,r) => {
  const sent=SPEECH.find(x=>x.id===it.sid);
  if(r){ box.classList.remove('locked'); box.innerHTML=`<div class="card p-5 text-center"><div class="han text-3xl font-black">${sent.han}</div><div class="text-slate-500 mt-1">${sent.py}</div><div class="text-sm text-slate-400">${sent.en}</div>${r.skipped?'<div class="text-xs text-amber-600 mt-2">'+t('skip')+'</div>':''}</div>`; return; }
  box.innerHTML=`<h2 class="qtitle">🎤 ${t('speech_title')}</h2><div id="spBox"></div><div class="text-center"><button class="link" id="skipSp">${t('skip')}</button></div>`;
  SpeechUI.mount($('#spBox'),sent,res=>{ cur.res=res; Lesson.sync(); });
  $('#skipSp').onclick=()=>Lesson.skip();
  cur.ans=()=>cur.res?{correct:cur.res.passed,user:cur.res.text,ans:sent.han}:null;
};

